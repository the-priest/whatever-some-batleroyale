; Block Royale - Godot 4 project
config_version=5

[application]
config/name="Block Royale"
config/description="Battle royale. Drop from the plane, loot, survive."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]
Boot="*res://scripts/boot.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[filesystem]
import/blender/enabled=false
import/fbx2gltf/enabled=false

[physics]
3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
rendering_device/fallback_to_d3d12=true
anti_aliasing/quality/use_taa=true
environment/sdfgi/probe_ray_count=2
environment/sdfgi/frames_to_converge=3
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
global_illumination/sdfgi/probe_ray_count=2
lights_and_shadows/positional_shadow/atlas_size=4096
mesh_lod/lod_change/threshold_pixels=1.0
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.62, 0.78, 0.9, 1)
